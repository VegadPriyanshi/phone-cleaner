<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/homeScrollView"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/screen_background"

    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:gravity="center_vertical"

        android:orientation="vertical"

        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">


        <!-- ========================================================= -->
        <!-- Storage Overview Card -->
        <!-- ========================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/storageCard"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:background="@drawable/bg_storage_gradient"

                android:orientation="vertical"

                android:padding="22dp">


                <!-- ================================================= -->
                <!-- Storage Header -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:gravity="center_vertical"

                    android:orientation="horizontal">


                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"

                        android:background="@drawable/bg_storage_icon"

                        android:contentDescription="Storage"

                        android:padding="10dp"

                        android:src="@drawable/ic_storage" />


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_marginStart="12dp"

                        android:layout_weight="1"

                        android:text="STORAGE"

                        android:textColor="@color/text_on_primary"

                        android:textSize="13sp"

                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/tvStoragePercentage"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="--%"

                        android:textColor="@color/text_on_primary"

                        android:textSize="25sp"

                        android:textStyle="bold" />

                </LinearLayout>


                <!-- ================================================= -->
                <!-- Main Storage Information -->
                <!-- ================================================= -->

                <TextView
                    android:id="@+id/tvStorageUsed"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="18dp"

                    android:text="Checking storage..."

                    android:textColor="@color/text_on_primary"

                    android:textSize="17sp"

                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/tvStorageInfo"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:text="Your storage information"

                    android:textColor="@color/primary_light"

                    android:textSize="13sp" />


                <!-- ================================================= -->
                <!-- Storage Progress -->
                <!-- ================================================= -->

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/storageProgress"

                    android:layout_width="match_parent"
                    android:layout_height="8dp"

                    android:layout_marginTop="18dp"

                    android:max="100"

                    android:progress="0"

                    app:indicatorColor="@android:color/white"

                    app:trackColor="#55FFFFFF"

                    app:trackCornerRadius="8dp"

                    app:trackThickness="8dp" />


                <!-- ================================================= -->
                <!-- Used / Free Storage -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="14dp"

                    android:orientation="horizontal">


                    <!-- ================================================= -->
                    <!-- Used Storage -->
                    <!-- ================================================= -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"

                        android:orientation="vertical">


                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:gravity="center_vertical"

                            android:orientation="horizontal">


                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"

                                android:contentDescription="Used storage"

                                android:src="@drawable/ic_storage_used" />


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:layout_marginStart="6dp"

                                android:text="Used"

                                android:textColor="@color/text_on_primary"

                                android:textSize="12sp" />

                        </LinearLayout>


                        <TextView
                            android:id="@+id/tvUsedStorage"

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="3dp"

                            android:text="-- GB"

                            android:textColor="@color/text_on_primary"

                            android:textSize="14sp"

                            android:textStyle="bold" />

                    </LinearLayout>


                    <!-- ================================================= -->
                    <!-- Free Storage -->
                    <!-- ================================================= -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"

                        android:gravity="end"

                        android:orientation="vertical">


                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:gravity="center_vertical"

                            android:orientation="horizontal">


                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"

                                android:contentDescription="Free storage"

                                android:src="@drawable/ic_storage_used" />


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:layout_marginStart="6dp"

                                android:text="Free"

                                android:textColor="@color/text_on_primary"

                                android:textSize="12sp" />

                        </LinearLayout>


                        <TextView
                            android:id="@+id/tvFreeStorage"

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="3dp"

                            android:text="-- GB"

                            android:textColor="@color/text_on_primary"

                            android:textSize="14sp"

                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ========================================================= -->
        <!-- Scan Now -->
        <!-- ========================================================= -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScanNow"

            android:layout_width="match_parent"
            android:layout_height="58dp"

            android:layout_marginTop="18dp"

            android:text="Scan Now"

            android:textAllCaps="false"

            android:textSize="16sp"

            android:textStyle="bold"

            app:cornerRadius="18dp" />


    </LinearLayout>

</androidx.core.widget.NestedScrollView>