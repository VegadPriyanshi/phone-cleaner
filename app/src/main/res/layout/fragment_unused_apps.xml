<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"

    android:background="@color/screen_background"

    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"

        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBackUnusedApps"

            android:layout_width="44dp"
            android:layout_height="44dp"

            android:background="?attr/selectableItemBackgroundBorderless"

            android:contentDescription="Back"

            android:padding="10dp"

            android:src="@drawable/ic_arrow_back"

            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginStart="4dp"

            android:layout_weight="1"

            android:text="Unused Apps"

            android:textColor="@color/text_primary"

            android:textSize="24sp"

            android:textStyle="bold" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- SUBTITLE -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/tvUnusedAppsSubtitle"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="2dp"

        android:text="Apps not used for more than 60 days"

        android:textColor="@color/text_secondary"

        android:textSize="14sp" />


    <!-- ===================================================== -->
    <!-- USAGE ACCESS CARD -->
    <!-- ===================================================== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/unusedUsageAccessCard"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="18dp"

        app:cardBackgroundColor="@color/apps_usage_card"

        app:cardCornerRadius="18dp"

        app:cardElevation="0dp"

        app:strokeColor="@color/apps_usage_stroke"

        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Usage Access required"

                android:textColor="@color/text_primary"

                android:textSize="16sp"

                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="5dp"

                android:text="Allow Usage Access so Phone Cleaner can see when apps were last used."

                android:textColor="@color/text_secondary"

                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUnusedUsageAccess"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="12dp"

                android:text="Allow access"

                android:textAllCaps="false"

                app:cornerRadius="14dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


    <!-- ===================================================== -->
    <!-- COUNT -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/tvUnusedAppsCount"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="20dp"

        android:text="0 apps"

        android:textColor="@color/text_secondary"

        android:textSize="14sp" />


    <!-- ===================================================== -->
    <!-- LOADING -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/unusedAppsLoading"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="24dp"

        android:gravity="center"

        android:orientation="vertical"

        android:padding="24dp">

        <ProgressBar
            android:layout_width="40dp"
            android:layout_height="40dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="12dp"

            android:text="Checking installed apps..."

            android:textColor="@color/text_secondary"

            android:textSize="14sp" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- EMPTY STATE -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/tvUnusedAppsEmpty"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="28dp"

        android:gravity="center"

        android:padding="24dp"

        android:text="No unused apps found."

        android:textColor="@color/text_secondary"

        android:textSize="15sp"

        android:visibility="gone" />


    <!-- ===================================================== -->
    <!-- APP LIST -->
    <!-- ===================================================== -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvUnusedApps"

        android:layout_width="match_parent"
        android:layout_height="0dp"

        android:layout_marginTop="12dp"

        android:layout_weight="1"

        android:clipToPadding="false"

        android:overScrollMode="never"

        android:paddingBottom="20dp"

        android:visibility="gone" />

</LinearLayout>