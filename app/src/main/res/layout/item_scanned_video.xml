<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/videoGridCard"
    android:layout_width="match_parent"
    android:layout_height="128dp"
    android:layout_margin="3dp"

    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Video Thumbnail -->

        <ImageView
            android:id="@+id/ivVideoThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_category_videos"
            android:contentDescription="Video thumbnail"
            android:scaleType="centerCrop" />

        <!-- Small dark overlay behind video information -->

        <View
            android:id="@+id/viewVideoInfoOverlay"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_gravity="bottom"
            android:background="#66000000" />

        <!-- Play button -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="center"
            app:cardBackgroundColor="#DDFFFFFF"
            app:cardCornerRadius="19dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/ivPlayIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Play video"
                android:padding="10dp"
                android:src="@android:drawable/ic_media_play"
                app:tint="#7655F6" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Video Size -->

        <TextView
            android:id="@+id/tvVideoSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="5dp"
            android:background="#99000000"
            android:paddingStart="5dp"
            android:paddingTop="2dp"
            android:paddingEnd="5dp"
            android:paddingBottom="2dp"
            android:text="0 MB"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Checkbox -->

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/checkVideo"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="top|end"
            android:layout_margin="5dp"
            android:buttonTint="@android:color/white"
            android:contentDescription="Select video" />

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>